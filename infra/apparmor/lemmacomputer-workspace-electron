# LemmaComputer workspace profile for policy-selected Chromium/Electron apps.
#
# This is the Moby docker-default policy shape with AppArmor ABI 4 classes
# made explicit and one additional permission: userns. Chromium uses that
# permission to create its renderer, PID, and network namespace sandbox when
# no-new-privileges deliberately disables the older setuid helper.
#
# Apply this profile only to LemmaComputer workspace containers that select a
# reviewed Chromium/Electron application. It is not an unconfined profile.

abi <abi/4.0>,
include <tunables/global>

profile lemmacomputer-workspace-electron flags=(attach_disconnected,mediate_deleted) {
  network,
  network unix,
  deny network alg,

  capability,
  file,
  umount,
  dbus,
  mqueue,
  unix,
  io_uring,

  # Required by Chromium's modern Linux process sandbox.
  userns,

  # Host runtimes may stop or kill container processes.
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,

  # Processes inside this one workspace may signal and trace each other.
  signal (send,receive) peer=lemmacomputer-workspace-electron,
  ptrace (trace,tracedby,read,readby) peer=lemmacomputer-workspace-electron,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny mount,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
