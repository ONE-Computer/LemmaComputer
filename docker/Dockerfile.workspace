# Managed workspace image. Product-owned runtime assets are grouped under
# docker/workspace until their application packaging is split into components.
FROM ghcr.io/astral-sh/uv:0.11.6-python3.13-trixie@sha256:b3c543b6c4f23a5f2df22866bd7857e5d304b67a564f4feab6ac22044dde719b AS uv_source

FROM node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS hermes_desktop_builder

ARG HERMES_AGENT_TAG=v2026.7.20
ARG HERMES_AGENT_SHA256=285f3fc134ff466a90065e1517801a68993733b807158ee8f32aa01613786990

RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get install -y --no-install-recommends build-essential ca-certificates curl git patch python3 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY docker/workspace/hermes-desktop-governed-effort.patch /tmp/hermes-desktop-governed-effort.patch
RUN curl -fsSLo /tmp/hermes-agent.tar.gz \
      "https://github.com/NousResearch/hermes-agent/archive/refs/tags/${HERMES_AGENT_TAG}.tar.gz" \
    && echo "${HERMES_AGENT_SHA256}  /tmp/hermes-agent.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/hermes-agent.tar.gz -C /src --strip-components=1 \
    && patch --batch --forward --fuzz=0 -d /src -p1 < /tmp/hermes-desktop-governed-effort.patch \
    && npm ci \
    && npm run pack --workspace apps/desktop \
    && test -x /src/apps/desktop/release/linux-unpacked/Hermes

FROM kasmweb/ubuntu-jammy-desktop@sha256:58b0710b320b99ab7e352342d7ec3a25b09740c523b75d794c5f7476910da580

USER root

ARG CLAUDE_DESKTOP_VERSION=1.22209.3
ARG CLAUDE_DESKTOP_SHA256=d427f46ac9233dbc4d8a441a602f09f750b8a5f05d1fc7a00285d7a6ce07655c
ARG CLAUDE_CODE_VERSION=2.1.215
ARG CLAUDE_CODE_SHA256=7ff9594e53cd89d1af9ceb3c18d3d70be1a5c6d27475e31ee2bed65d748f18c0
ARG FIREFOX_VERSION=140.12.0esr
ARG FIREFOX_SHA256=3323ee13ac6fe4877fa2e1f4a3aa6b8009f65a620c7bbca96fe86f1a6f433d92
ARG GOOGLE_CHROME_VERSION=151.0.7922.137-1
ARG GOOGLE_CHROME_SHA256=e6dabf044cf9cd0279cfe86efa431682c18bfc06d06339ce055aaa87ae871727
ARG VSCODE_VERSION=1.133.0
ARG VSCODE_SHA256=d064e87e22f556b8a91e1354b5227e340597324e52886dbb288551596b00e34a
ARG OBSIDIAN_VERSION=1.13.7
ARG OBSIDIAN_SHA256=17dc33b49cb3e785ecc27edd2ea0c79e40207798b554fd2886e36ebee7af9ae0
ARG HERMES_AGENT_VERSION=0.19.0
ARG HERMES_AGENT_TAG=v2026.7.20
ARG HERMES_AGENT_SHA256=285f3fc134ff466a90065e1517801a68993733b807158ee8f32aa01613786990
ARG HERMES_OFFICE_SKILLS_COMMIT=a606d24cf2a9d1137d77fd92e7da459c89947fbd
ARG HERMES_OFFICE_SKILLS_SHA256=c379fc38badf3bc31938be80c15aa3a13bc6c4bb3b852902e5d988676763c20c
ARG HERMES_PYTHON_VERSION=3.13.5
ARG NODE_VERSION=22.23.1
ARG NODE_SHA256=9749e988f437343b7fa832c69ded82a312e41a03116d766797ac14f6f9eee578

COPY --chmod=0755 --from=uv_source /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/
COPY --chmod=0755 docker/workspace/lemmacomputer-libreoffice /usr/local/libexec/lemmacomputer-libreoffice
COPY docker/workspace/hermes-agent-lemmacomputer.patch /tmp/hermes-agent-lemmacomputer.patch
COPY docker/workspace/hermes-agent-instance.patch /tmp/hermes-agent-instance.patch
COPY docker/workspace/hermes-agent-activity.patch /tmp/hermes-agent-activity.patch
COPY docker/workspace/lemmacomputer_hermes_mcp_identity.py /tmp/lemmacomputer_hermes_mcp_identity.py

RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get purge -y \
      code firefox gimp gimp-data google-chrome-stable \
      nextcloud-desktop nextcloud-desktop-common nextcloud-desktop-doc nextcloud-desktop-l10n \
      obs-studio obs-v4l2sink onlyoffice-desktopeditors \
      remmina remmina-common remmina-plugin-rdp remmina-plugin-secret remmina-plugin-spice remmina-plugin-vnc \
      signal-desktop slack-desktop sublime-text thunderbird zoom \
    && apt-get autoremove -y \
    && curl -fsSLo /tmp/claude-desktop.deb \
      "https://downloads.claude.ai/claude-desktop/apt/stable/pool/main/c/claude-desktop/claude-desktop_${CLAUDE_DESKTOP_VERSION}_amd64.deb" \
    && curl -fsSLo /tmp/claude-code.zst \
      "https://downloads.claude.ai/claude-code-releases/${CLAUDE_CODE_VERSION}/linux-x64/claude.zst" \
    && curl -fsSLo /tmp/firefox.tar.xz \
      "https://ftp.mozilla.org/pub/firefox/releases/${FIREFOX_VERSION}/linux-x86_64/en-US/firefox-${FIREFOX_VERSION}.tar.xz" \
    && curl -fsSLo /tmp/google-chrome.deb \
      "https://dl.google.com/linux/chrome/deb/pool/main/g/google-chrome-stable/google-chrome-stable_${GOOGLE_CHROME_VERSION}_amd64.deb" \
    && curl -fsSLo /tmp/code.deb \
      "https://vscode.download.prss.microsoft.com/dbazure/download/stable/a5b500951314efd502d07465bd138dfbd714a960/code_1.133.0-1786487972_amd64.deb" \
    && curl -fsSLo /tmp/obsidian.deb \
      "https://github.com/obsidianmd/obsidian-releases/releases/download/v${OBSIDIAN_VERSION}/obsidian_${OBSIDIAN_VERSION}_amd64.deb" \
    && curl -fsSLo /tmp/hermes-agent.tar.gz \
      "https://github.com/NousResearch/hermes-agent/archive/refs/tags/${HERMES_AGENT_TAG}.tar.gz" \
    && curl -fsSLo /tmp/hermes-office-skills.tar.gz \
      "https://github.com/NousResearch/hermes-agent/archive/${HERMES_OFFICE_SKILLS_COMMIT}.tar.gz" \
    && curl -fsSLo /tmp/node.tar.xz \
      "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
    && echo "${CLAUDE_DESKTOP_SHA256}  /tmp/claude-desktop.deb" | sha256sum -c - \
    && echo "${CLAUDE_CODE_SHA256}  /tmp/claude-code.zst" | sha256sum -c - \
    && echo "${FIREFOX_SHA256}  /tmp/firefox.tar.xz" | sha256sum -c - \
    && echo "${GOOGLE_CHROME_SHA256}  /tmp/google-chrome.deb" | sha256sum -c - \
    && echo "${VSCODE_SHA256}  /tmp/code.deb" | sha256sum -c - \
    && echo "${OBSIDIAN_SHA256}  /tmp/obsidian.deb" | sha256sum -c - \
    && echo "${HERMES_AGENT_SHA256}  /tmp/hermes-agent.tar.gz" | sha256sum -c - \
    && echo "${HERMES_OFFICE_SKILLS_SHA256}  /tmp/hermes-office-skills.tar.gz" | sha256sum -c - \
    && echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum -c - \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      cron=3.0pl1-137ubuntu3 \
      fonts-dejavu-core \
      fonts-liberation2 \
      fonts-noto-cjk \
      fonts-noto-color-emoji \
      fonts-noto-core \
      libreoffice \
      mousepad \
      ovmf \
      patch \
      pandoc \
      poppler-utils \
      qemu-system-x86 \
      qpdf \
      tesseract-ocr \
      unzip \
      zip \
      zstd \
      /tmp/claude-desktop.deb \
      /tmp/google-chrome.deb \
      /tmp/code.deb \
      /tmp/obsidian.deb \
    && rm -f /usr/share/applications/code.desktop /usr/share/applications/obsidian.desktop \
    && ln -s /usr/local/libexec/lemmacomputer-libreoffice /usr/local/bin/soffice \
    && ln -s /usr/local/libexec/lemmacomputer-libreoffice /usr/local/bin/libreoffice \
    && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
    && tar -xJf /tmp/firefox.tar.xz -C /opt \
    && install -d -o root -g root -m 0755 /opt/lemmacomputer/hermes-agent \
    && tar -xzf /tmp/hermes-agent.tar.gz -C /opt/lemmacomputer/hermes-agent --strip-components=1 \
    && install -o root -g root -m 0644 /tmp/lemmacomputer_hermes_mcp_identity.py /opt/lemmacomputer/hermes-agent/lemmacomputer_hermes_mcp_identity.py \
    && patch --batch --forward --fuzz=0 -d /opt/lemmacomputer/hermes-agent -p1 < /tmp/hermes-agent-lemmacomputer.patch \
    && patch --batch --forward --fuzz=0 -d /opt/lemmacomputer/hermes-agent -p1 < /tmp/hermes-agent-instance.patch \
    && patch --batch --forward --fuzz=0 -d /opt/lemmacomputer/hermes-agent -p1 < /tmp/hermes-agent-activity.patch \
    && install -d -o root -g root -m 0755 /tmp/hermes-office-skills \
    && tar -xzf /tmp/hermes-office-skills.tar.gz -C /tmp/hermes-office-skills --strip-components=1 \
    && rm -rf \
      /opt/lemmacomputer/hermes-agent/skills/productivity/docx \
      /opt/lemmacomputer/hermes-agent/skills/productivity/pdf \
      /opt/lemmacomputer/hermes-agent/skills/productivity/powerpoint \
      /opt/lemmacomputer/hermes-agent/skills/productivity/xlsx \
      /opt/lemmacomputer/hermes-agent/skills/productivity/ocr-and-documents \
    && cp -a /tmp/hermes-office-skills/skills/productivity/docx /opt/lemmacomputer/hermes-agent/skills/productivity/docx \
    && cp -a /tmp/hermes-office-skills/skills/productivity/pdf /opt/lemmacomputer/hermes-agent/skills/productivity/pdf \
    && cp -a /tmp/hermes-office-skills/skills/productivity/powerpoint /opt/lemmacomputer/hermes-agent/skills/productivity/powerpoint \
    && cp -a /tmp/hermes-office-skills/skills/productivity/xlsx /opt/lemmacomputer/hermes-agent/skills/productivity/xlsx \
    && cp -a /tmp/hermes-office-skills/skills/productivity/ocr-and-documents /opt/lemmacomputer/hermes-agent/skills/productivity/ocr-and-documents \
    && uv python install "${HERMES_PYTHON_VERSION}" --install-dir /opt/lemmacomputer/python --no-bin --no-progress \
    && UV_PROJECT_ENVIRONMENT=/opt/lemmacomputer/hermes-venv \
      uv sync --project /opt/lemmacomputer/hermes-agent --frozen --no-dev --no-editable \
      --python "/opt/lemmacomputer/python/cpython-${HERMES_PYTHON_VERSION}-linux-x86_64-gnu/bin/python" \
    && HERMES_IDENTITY_SITE_PACKAGES="$(/opt/lemmacomputer/hermes-venv/bin/python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" \
    && install -o root -g root -m 0644 \
      /tmp/lemmacomputer_hermes_mcp_identity.py \
      "${HERMES_IDENTITY_SITE_PACKAGES}/lemmacomputer_hermes_mcp_identity.py" \
    && (cd /home/kasm-user \
      && /opt/lemmacomputer/hermes-venv/bin/python -c 'import lemmacomputer_hermes_mcp_identity') \
    && uv pip install \
      --python /opt/lemmacomputer/hermes-venv/bin/python \
      --no-deps \
      aiohappyeyeballs==2.6.1 \
      aiohttp==3.14.1 \
      aiosignal==1.4.0 \
      attrs==25.4.0 \
      frozenlist==1.8.0 \
      multidict==6.7.1 \
      propcache==0.4.1 \
      yarl==1.22.0 \
    && test "$(/opt/lemmacomputer/hermes-venv/bin/python -c 'import aiohttp; print(aiohttp.__version__)')" = "3.14.1" \
    && test "$(/opt/lemmacomputer/hermes-venv/bin/python -c 'from hermes_cli import __version__; print(__version__)')" = "${HERMES_AGENT_VERSION}" \
    && test "$(node --version)" = "v${NODE_VERSION}" \
    && command -v npm soffice libreoffice pandoc pdftoppm pdftotext qpdf tesseract unzip zip \
    && soffice --headless --version \
    && test -f /opt/lemmacomputer/hermes-agent/skills/productivity/docx/SKILL.md \
    && test -f /opt/lemmacomputer/hermes-agent/skills/productivity/pdf/SKILL.md \
    && test -f /opt/lemmacomputer/hermes-agent/skills/productivity/powerpoint/SKILL.md \
    && test -f /opt/lemmacomputer/hermes-agent/skills/productivity/xlsx/SKILL.md \
    && test -f /opt/lemmacomputer/hermes-agent/skills/productivity/ocr-and-documents/SKILL.md \
    && ln -s /opt/firefox/firefox /usr/local/bin/firefox \
    && ln -s /opt/lemmacomputer/hermes-venv/bin/hermes /usr/local/bin/hermes \
    && command -v qemu-system-x86_64 \
    && test -x /usr/lib/claude-desktop/resources/virtiofsd \
    && test -f /usr/share/OVMF/OVMF_CODE.fd \
    && install -d -o root -g root -m 0755 "/opt/lemmacomputer/claude-code/${CLAUDE_CODE_VERSION}" \
    && unzstd -c /tmp/claude-code.zst > "/opt/lemmacomputer/claude-code/${CLAUDE_CODE_VERSION}/claude" \
    && chmod 0755 "/opt/lemmacomputer/claude-code/${CLAUDE_CODE_VERSION}/claude" \
    && test "$(/opt/lemmacomputer/claude-code/${CLAUDE_CODE_VERSION}/claude --version | awk '{print $1}')" = "${CLAUDE_CODE_VERSION}" \
    && test "$(/opt/firefox/firefox --version | awk '{print $3}')" = "${FIREFOX_VERSION}" \
    && test "$(google-chrome-stable --version | awk '{print $3}')" = "${GOOGLE_CHROME_VERSION%-1}" \
    && test "$(dpkg-query -W -f='${Version}' code | sed -E 's/-[0-9]+$//')" = "${VSCODE_VERSION}" \
    && test "$(dpkg-query -W -f='${Version}' obsidian)" = "${OBSIDIAN_VERSION}" \
    && test -x /usr/share/code/code \
    && test -x /opt/Obsidian/obsidian \
    && command -v unshare \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /root/.cache/uv /tmp/claude-desktop.deb /tmp/claude-code.zst /tmp/firefox.tar.xz /tmp/google-chrome.deb /tmp/code.deb /tmp/obsidian.deb /tmp/hermes-agent-activity.patch /tmp/hermes-agent-instance.patch /tmp/hermes-agent-lemmacomputer.patch /tmp/hermes-agent.tar.gz /tmp/hermes-office-skills.tar.gz /tmp/hermes-office-skills /tmp/lemmacomputer_hermes_mcp_identity.py /tmp/node.tar.xz /opt/Telegram \
      /home/kasm-default-profile/Desktop/* \
      /home/kasm-default-profile/.mozilla \
      /home/kasm-default-profile/.local/share/remmina \
    && install -d -o root -g root -m 0755 /etc/claude-desktop /run/lemmacomputer

COPY docker/workspace/hermes-office-node/package.json docker/workspace/hermes-office-node/package-lock.json /opt/lemmacomputer/hermes-office-node/
RUN npm ci \
      --prefix /opt/lemmacomputer/hermes-office-node \
      --omit=dev \
      --no-audit \
      --no-fund \
    && NODE_PATH=/opt/lemmacomputer/hermes-office-node/node_modules \
      node -e 'for (const name of ["docx", "pptxgenjs", "react", "react-dom", "react-icons", "sharp"]) require.resolve(name)' \
    && npm cache clean --force

RUN uv pip install \
      --python /opt/lemmacomputer/hermes-venv/bin/python \
      mcp==1.26.0 \
      starlette==1.0.1 \
    && test "$(/opt/lemmacomputer/hermes-venv/bin/python -c 'import importlib.metadata; print(importlib.metadata.version("mcp"))')" = "1.26.0"

COPY docker/workspace/hermes-office-requirements.txt /opt/lemmacomputer/hermes-office-requirements.txt
RUN uv venv \
      --python "/opt/lemmacomputer/python/cpython-${HERMES_PYTHON_VERSION}-linux-x86_64-gnu/bin/python" \
      /opt/lemmacomputer/hermes-office-venv \
    && uv pip install \
      --python /opt/lemmacomputer/hermes-office-venv/bin/python \
      --requirements /opt/lemmacomputer/hermes-office-requirements.txt \
    && /opt/lemmacomputer/hermes-office-venv/bin/python -c \
      'import defusedxml, docx, fitz, lxml, markitdown, openpyxl, pandas, pdf2image, pdfplumber, PIL, pptx, pypdf, pytesseract, reportlab' \
    && /opt/lemmacomputer/hermes-office-venv/bin/markitdown --help >/dev/null \
    && rm -rf /root/.cache/uv

COPY docker/workspace/agent-chat-requirements.txt /opt/lemmacomputer/agent-chat-requirements.txt
RUN uv venv \
      --python "/opt/lemmacomputer/python/cpython-${HERMES_PYTHON_VERSION}-linux-x86_64-gnu/bin/python" \
      /opt/lemmacomputer/agent-chat-venv \
    && uv pip install \
      --python /opt/lemmacomputer/agent-chat-venv/bin/python \
      --requirements /opt/lemmacomputer/agent-chat-requirements.txt \
    && test "$(/opt/lemmacomputer/agent-chat-venv/bin/python -c 'import importlib.metadata; print(importlib.metadata.version("claude-agent-sdk"))')" = "0.2.128" \
    && test "$(/opt/lemmacomputer/agent-chat-venv/bin/python -c 'import importlib.metadata; print(importlib.metadata.version("openai-codex"))')" = "0.144.4" \
    && codex_bin="$(/opt/lemmacomputer/agent-chat-venv/bin/python -c 'from codex_cli_bin import bundled_codex_path; print(bundled_codex_path())')" \
    && test -x "$codex_bin" \
    && install -d -o root -g root -m 0755 /usr/local/libexec \
    && ln -s "$codex_bin" /usr/local/libexec/lemmacomputer-codex-bin \
    && rm -rf /root/.cache/uv

ENV PATH="/opt/lemmacomputer/hermes-office-venv/bin:${PATH}" \
    NODE_PATH="/opt/lemmacomputer/hermes-office-node/node_modules"

RUN python -c \
      'import defusedxml, docx, fitz, lxml, markitdown, openpyxl, pandas, pdf2image, pdfplumber, PIL, pptx, pypdf, pytesseract, reportlab' \
    && node -e \
      'for (const name of ["docx", "pptxgenjs", "react", "react-dom", "react-icons", "sharp"]) require.resolve(name)'

COPY --from=hermes_desktop_builder /src/apps/desktop/release/linux-unpacked /opt/lemmacomputer/hermes-desktop
COPY --from=hermes_desktop_builder /src/apps/desktop/assets/icon.png /opt/lemmacomputer/hermes-desktop-icon.png
COPY docker/workspace/lemmacomputer-gateway-proxy.py /usr/local/libexec/lemmacomputer-gateway-proxy
COPY docker/workspace/lemmacomputer-agent-launch.py /usr/local/libexec/lemmacomputer-agent-launch
COPY docker/workspace/lemmacomputer-sites.py /usr/local/bin/lemmacomputer-sites
COPY skills/make-a-site /opt/lemmacomputer/skills/make-a-site
COPY skills/make-a-site /opt/lemmacomputer/hermes-agent/skills/lemmacomputer/make-a-site
COPY docker/workspace/lemmacomputer-egress-broker.py /usr/local/libexec/lemmacomputer-egress-broker
COPY docker/workspace/lemmacomputer-connectors-stdio.py /usr/local/libexec/lemmacomputer-connectors-stdio
COPY --chmod=0644 docker/workspace/lemmacomputer_work_trace.py /usr/local/libexec/lemmacomputer_work_trace.py
COPY docker/workspace/lemmacomputer-agent-chat.py /usr/local/libexec/lemmacomputer-agent-chat
COPY docker/workspace/lemmacomputer-hermes-config.py /usr/local/libexec/lemmacomputer-hermes-config
COPY docker/workspace/lemmacomputer-claude-config.py /usr/local/libexec/lemmacomputer-claude-config
COPY --chmod=0755 docker/workspace/lemmacomputer-workspace-home-init.sh /usr/local/libexec/lemmacomputer-workspace-home-init
COPY docker/workspace/lemmacomputer-kasm-clipboard.js /usr/share/kasmvnc/www/app/lemmacomputer-kasm-clipboard.js
COPY docker/workspace/lemmacomputer-workspace-entrypoint.sh /usr/local/sbin/lemmacomputer-workspace-entrypoint
COPY docker/workspace/claude-desktop.desktop /usr/local/share/lemmacomputer/applications/lemmacomputer-claude-desktop.desktop
COPY docker/workspace/lemmacomputer-claude-desktop /usr/local/bin/lemmacomputer-claude-desktop
COPY docker/workspace/claude-cli.desktop /usr/local/share/lemmacomputer/applications/lemmacomputer-claude-cli.desktop
COPY docker/workspace/lemmacomputer-claude /usr/local/bin/lemmacomputer-claude
COPY docker/workspace/codex-cli.desktop /usr/local/share/lemmacomputer/applications/lemmacomputer-codex-cli.desktop
COPY docker/workspace/lemmacomputer-codex /usr/local/bin/lemmacomputer-codex
COPY docker/workspace/firefox.desktop /usr/local/share/lemmacomputer/applications/lemmacomputer-firefox.desktop
COPY docker/workspace/firefox-policies.json /opt/firefox/distribution/policies.json
COPY docker/workspace/google-chrome.desktop /usr/local/share/lemmacomputer/applications/lemmacomputer-google-chrome.desktop
COPY docker/workspace/google-chrome-policies.json /etc/opt/chrome/policies/managed/lemmacomputer.json
COPY docker/workspace/visual-studio-code.desktop /usr/local/share/lemmacomputer/applications/lemmacomputer-visual-studio-code.desktop
COPY docker/workspace/obsidian.desktop /usr/local/share/lemmacomputer/applications/lemmacomputer-obsidian.desktop
COPY docker/workspace/lemmacomputer-hermes /usr/local/bin/lemmacomputer-hermes
COPY docker/workspace/hermes-agent-cli.desktop /usr/local/share/lemmacomputer/applications/lemmacomputer-hermes-agent-cli.desktop
COPY docker/workspace/lemmacomputer-hermes-desktop /usr/local/bin/lemmacomputer-hermes-desktop
COPY docker/workspace/hermes-desktop.desktop /usr/local/share/lemmacomputer/applications/lemmacomputer-hermes-desktop.desktop
COPY docker/workspace/lemmacomputer-crontab /usr/local/bin/lemmacomputer-crontab
COPY docker/workspace/lemmacomputer-cron-run /usr/local/bin/lemmacomputer-cron-run
COPY docker/workspace/SCHEDULING.md /usr/local/share/lemmacomputer/SCHEDULING.md
# The Kasm profile is immutable image content copied into a fresh volume by
# UID/GID 1000. Normalize it once at build time instead of repairing every
# persistent-home entry on every workspace start.
RUN chmod 0755 \
      /usr/local/libexec/lemmacomputer-egress-broker \
      /usr/local/libexec/lemmacomputer-gateway-proxy \
      /usr/local/libexec/lemmacomputer-agent-launch \
      /usr/local/libexec/lemmacomputer-connectors-stdio \
      /usr/local/libexec/lemmacomputer-agent-chat \
      /usr/local/libexec/lemmacomputer-hermes-config \
      /usr/local/libexec/lemmacomputer-claude-config \
      /usr/local/libexec/lemmacomputer-libreoffice \
      /usr/local/sbin/lemmacomputer-workspace-entrypoint \
      /usr/local/bin/lemmacomputer-claude-desktop \
      /usr/local/bin/lemmacomputer-claude \
      /usr/local/bin/lemmacomputer-codex \
      /usr/local/bin/lemmacomputer-hermes \
      /usr/local/bin/lemmacomputer-hermes-desktop \
      /usr/local/bin/lemmacomputer-sites \
      /usr/local/bin/lemmacomputer-crontab \
      /usr/local/bin/lemmacomputer-cron-run \
      /usr/local/share/lemmacomputer/applications/lemmacomputer-claude-desktop.desktop \
      /usr/local/share/lemmacomputer/applications/lemmacomputer-claude-cli.desktop \
      /usr/local/share/lemmacomputer/applications/lemmacomputer-codex-cli.desktop \
      /usr/local/share/lemmacomputer/applications/lemmacomputer-firefox.desktop \
      /usr/local/share/lemmacomputer/applications/lemmacomputer-google-chrome.desktop \
      /usr/local/share/lemmacomputer/applications/lemmacomputer-visual-studio-code.desktop \
      /usr/local/share/lemmacomputer/applications/lemmacomputer-obsidian.desktop \
      /usr/local/share/lemmacomputer/applications/lemmacomputer-hermes-agent-cli.desktop \
      /usr/local/share/lemmacomputer/applications/lemmacomputer-hermes-desktop.desktop \
    && test -f /opt/lemmacomputer/skills/make-a-site/SKILL.md \
    && test -f /opt/lemmacomputer/hermes-agent/skills/lemmacomputer/make-a-site/SKILL.md \
    && chmod 0644 /usr/share/kasmvnc/www/app/lemmacomputer-kasm-clipboard.js /opt/firefox/distribution/policies.json /etc/opt/chrome/policies/managed/lemmacomputer.json /usr/local/share/lemmacomputer/SCHEDULING.md \
    && test "$(dpkg-query -W -f='${Version}' cron)" = "3.0pl1-137ubuntu3" \
    && grep -q 'dist/style.bundle.js' /usr/share/kasmvnc/www/index.html \
    && printf '%s\n' '<script src="app/lemmacomputer-kasm-clipboard.js"></script>' >> /usr/share/kasmvnc/www/index.html \
    && chown -R 1000:1000 /home/kasm-default-profile

# Probe frequently only while Docker still considers the container to be
# starting. A successful check exits the start period immediately, after which
# the existing five-second steady-state cadence applies.
HEALTHCHECK --interval=5s --timeout=2s --start-period=15s --start-interval=1s --retries=12 \
  CMD test -f /run/lemmacomputer/workspace-ready \
    && timeout 1 bash -c 'exec 3<>/dev/tcp/127.0.0.1/6901' \
    && { test ! -f /run/lemmacomputer/gateway-proxy.pid || curl -fsS http://127.0.0.1:4312/healthz >/dev/null; } \
    && { test ! -f /run/lemmacomputer/hermes-gateway-proxy.pid || curl -fsS http://127.0.0.1:4314/healthz >/dev/null; } \
    && { test ! -f /run/lemmacomputer/claude-cli-gateway-proxy.pid || curl -fsS http://127.0.0.1:4315/healthz >/dev/null; } \
    && { test ! -f /run/lemmacomputer/hermes-desktop-gateway-proxy.pid || curl -fsS http://127.0.0.1:4316/healthz >/dev/null; } \
    && { test ! -f /run/lemmacomputer/codex-cli-gateway-proxy.pid || curl -fsS http://127.0.0.1:4317/healthz >/dev/null; } \
    && { test ! -f /run/lemmacomputer/hermes-gateway.pid || curl -fsS http://127.0.0.1:8652/health >/dev/null; } \
    && { test ! -f /run/lemmacomputer/hermes-claw-chat.pid || timeout 1 bash -c 'exec 3<>/dev/tcp/127.0.0.1/8642'; } \
    || exit 1

USER root
ENTRYPOINT ["/usr/local/sbin/lemmacomputer-workspace-entrypoint"]
CMD ["--tail-log"]
