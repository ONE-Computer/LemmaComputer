#!/usr/bin/env bash
set -euo pipefail
export LEMMACOMPUTER_SITES_BROKER=http://127.0.0.1:4315

export ANTHROPIC_BASE_URL=http://127.0.0.1:4315
export ANTHROPIC_AUTH_TOKEN=lemmacomputer-loopback-broker
export CLAUDE_CONFIG_DIR=/home/kasm-user/.claude-cli
source /home/kasm-user/.claude-cli/lemmacomputer.env

exec /usr/local/libexec/lemmacomputer-agent-launch claude-cli /opt/lemmacomputer/claude-code/2.1.215/claude \
  --model "$LEMMACOMPUTER_MODEL_ALIAS" \
  --mcp-config /home/kasm-user/.claude-cli/mcp.json \
  --strict-mcp-config \
  "$@"
