#!/usr/bin/env bash
set -euo pipefail

export ANTHROPIC_BASE_URL=http://127.0.0.1:4315
export ANTHROPIC_AUTH_TOKEN=onecomputer-loopback-broker
export CLAUDE_CONFIG_DIR=/home/kasm-user/.claude-cli
source /home/kasm-user/.claude-cli/onecomputer.env

exec /opt/onecomputer/claude-code/2.1.215/claude \
  --model "$ONECOMPUTER_MODEL_ALIAS" \
  --mcp-config /home/kasm-user/.claude-cli/mcp.json \
  --strict-mcp-config \
  "$@"
