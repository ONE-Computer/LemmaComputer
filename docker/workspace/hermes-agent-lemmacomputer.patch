     # that the sanitized form is safe to pass into Honcho / state.db.
     _MAX_SESSION_HEADER_LEN = 256
 
+    _AI_USAGE_TASK_BINDING_HEADER = "x-lemmacomputer-ai-task-binding"
+    _AI_USAGE_TASK_BINDING_PATTERN = re.compile(r"^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$")
+
+    def _parse_ai_usage_task_binding_header(
+        self, request: "web.Request"
+    ) -> tuple[Optional[str], Optional["web.Response"]]:
+        """Return LemmaComputer's bounded signed per-turn usage binding."""
+        raw = request.headers.get(self._AI_USAGE_TASK_BINDING_HEADER, "").strip()
+        if not raw:
+            return None, None
+        if (
+            not 32 <= len(raw) <= 4096
+            or self._AI_USAGE_TASK_BINDING_PATTERN.fullmatch(raw) is None
+        ):
+            return None, web.json_response(
+                _openai_error(
+                    "Invalid AI usage task binding",
+                    code="invalid_ai_usage_task_binding",
+                ),
+                status=400,
+            )
+        return raw, None
+
