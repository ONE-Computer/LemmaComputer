+_REQUIRED_MCP_SERVER_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$")
+def _required_mcp_server() -> Optional[str]:
+    """Return the product-required MCP server, rejecting unsafe names."""
+    name = os.environ.get("LEMMACOMPUTER_REQUIRED_MCP_SERVER", "").strip()
+    if not name:
+        return None
+    if _REQUIRED_MCP_SERVER_RE.fullmatch(name) is None:
+        raise RuntimeError("Invalid required MCP server configuration")
+    return name
+def _required_mcp_server_readiness() -> Dict[str, Any]:
+    """Return a safe readiness summary without exposing server or tool names."""
+    required_server = _required_mcp_server()
+    if required_server is None:
+        return {"configured": False, "ready": True, "tool_count": 0}
+    from tools.mcp_tool import get_mcp_status
+
+    status = next(
+        (item for item in get_mcp_status() if item.get("name") == required_server),
+        None,
+    )
+    tool_count = status.get("tools", 0) if isinstance(status, dict) else 0
+    if not isinstance(tool_count, int) or isinstance(tool_count, bool):
+        tool_count = 0
+    return {
+        "configured": True,
+        "ready": bool(status and status.get("connected") is True and tool_count > 0),
+        "tool_count": tool_count,
+    }
