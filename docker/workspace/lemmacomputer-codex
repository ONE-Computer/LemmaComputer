#!/usr/bin/env bash
set -euo pipefail
export LEMMACOMPUTER_SITES_BROKER=http://127.0.0.1:4317

export CODEX_HOME=/home/kasm-user/.codex-cli
export OPENAI_BASE_URL=http://127.0.0.1:4317/v1
export OPENAI_API_KEY=lemmacomputer-loopback-broker

if [[ "${LEMMACOMPUTER_EXECUTION_MODE:-managed}" == "disposable-open" ]]; then
  sandbox_mode="danger-full-access"
else
  sandbox_mode="read-only"
fi

exec /usr/local/libexec/lemmacomputer-agent-launch codex-cli /usr/local/libexec/lemmacomputer-codex-bin \
  --model "$LEMMACOMPUTER_CODEX_CLI_MODEL_ALIAS" \
  --sandbox "$sandbox_mode" \
  --ask-for-approval never \
  "$@"
