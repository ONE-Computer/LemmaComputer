#!/usr/bin/env bash
set -uo pipefail

job_id="${1:-}"
timeout_seconds="${2:-}"
shift 2 2>/dev/null || true
if [[ ! "$job_id" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$ ]] \
  || [[ ! "$timeout_seconds" =~ ^[0-9]+$ ]] \
  || (( timeout_seconds < 1 || timeout_seconds > 86400 )) \
  || [[ "$#" -eq 0 ]]; then
  echo "usage: lemmacomputer-cron-run JOB_ID TIMEOUT_SECONDS COMMAND [ARG ...]" >&2
  exit 64
fi

state_dir="/home/kasm-user/.lemmacomputer"
log_dir="${state_dir}/logs"
lock_dir="${state_dir}/locks"
install -d -m 0700 "$log_dir" "$lock_dir"
log_file="${log_dir}/${job_id}.log"
lock_file="${lock_dir}/${job_id}.lock"
touch "$log_file"
chmod 0600 "$log_file"

started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
printf '{"event":"cron_job_start","jobId":"%s","startedAt":"%s"}\n' "$job_id" "$started_at" >> /run/lemmacomputer/cron-events.log

exec 9>"$lock_file"
if ! flock -n 9; then
  status=75
  outcome="overlap_skipped"
else
  set +e
  timeout --signal=TERM --kill-after=15s "$timeout_seconds" "$@" >>"$log_file" 2>&1
  status=$?
  set -e
  if (( status == 124 || status == 137 )); then
    outcome="timed_out"
  elif (( status == 0 )); then
    outcome="completed"
  else
    outcome="failed"
  fi
fi
completed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
printf '{"event":"cron_job_finish","jobId":"%s","completedAt":"%s","outcome":"%s","exitStatus":%d}\n' \
  "$job_id" "$completed_at" "$outcome" "$status" >> /run/lemmacomputer/cron-events.log

if [[ "$(stat -c %s "$log_file")" -gt 5242880 ]]; then
  tail -c 2097152 "$log_file" > "${log_file}.rotate"
  mv -f "${log_file}.rotate" "$log_file"
  chmod 0600 "$log_file"
fi
exit "$status"
