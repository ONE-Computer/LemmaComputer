# ONEComputer deployment environment
#
# Generated from scripts/deployment-config.mjs. Do not edit this file by hand.
# Run `npm run env:init` to create .env with fresh local secrets, then
# replace deployment-specific placeholders. Never commit .env.

# Deployment profile and local topology
# Set the profile explicitly for every deployment. Worktree values are replaced by npm run worktree:init.
# Deployment profile: customer-managed, hosted, or worktree.
ONECOMPUTER_INSTALLATION_KIND=customer-managed
# Compose project name. Keep this unique for each local worktree.
ONECOMPUTER_COMPOSE_PROJECT_NAME=onecomputer
# ONEComputer control-runtime and workspace image tag.
ONECOMPUTER_IMAGE_TAG=dev
# Version recorded with schema and operational events.
ONECOMPUTER_APP_VERSION=dev
# Microsoft 365 MCP image tag used by the reference deployment.
ONECOMPUTER_MS365_IMAGE_TAG=0.131.2
# Private Docker network name used by local Kasm workspaces.
ONECOMPUTER_CONTROL_NETWORK=onecomputer-control
# Control API container name used by the local Kasm adapter.
ONECOMPUTER_CONTROL_CONTAINER=onecomputer-control-api
# LiteLLM container name used by the local Kasm adapter.
ONECOMPUTER_LITELLM_CONTAINER=onecomputer-litellm
# Address used for reference-stack published ports.
ONECOMPUTER_HTTP_BIND_ADDRESS=127.0.0.1

# Public endpoints
# Use externally reachable HTTPS URLs in production. The reference stack binds loopback ports by default.
# Published ONEComputer Web and workspace-ingress port.
ONECOMPUTER_WEB_PORT=4174
# Public Web and workspace ingress base URL.
ONECOMPUTER_PUBLIC_WEB_URL=http://localhost:4174

# LiteLLM administration mutual TLS
# Hosted deployments must set an HTTPS admin URL and inject every certificate value from the deployment secret manager.
# Control-to-LiteLLM administration listener URL.
ONECOMPUTER_LITELLM_ADMIN_URL=http://litellm-admin-listener:8443
# Base64 PEM certificate authority for the private admin listener.
ONECOMPUTER_LITELLM_ADMIN_TLS_CA_B64=
# Base64 PEM server certificate for the private admin listener.
ONECOMPUTER_LITELLM_ADMIN_TLS_SERVER_CERT_B64=
# Base64 PEM server private key for the private admin listener.
ONECOMPUTER_LITELLM_ADMIN_TLS_SERVER_KEY_B64=
# Base64 PEM Control client certificate for the private admin listener.
ONECOMPUTER_LITELLM_ADMIN_TLS_CLIENT_CERT_B64=
# Base64 PEM Control client private key for the private admin listener.
ONECOMPUTER_LITELLM_ADMIN_TLS_CLIENT_KEY_B64=
# Expected TLS server name for Control's private admin client.
ONECOMPUTER_LITELLM_ADMIN_TLS_SERVER_NAME=litellm-admin-listener
# Required Control client certificate common name at the private admin listener.
ONECOMPUTER_LITELLM_ADMIN_CLIENT_COMMON_NAME=onecomputer-control

# Custom MCP egress
# Hosted custom MCP destinations are approved by the deployment and network owner, not by a tenant-local administrator.
# Comma-separated exact HTTPS origins for hosted custom MCP and OAuth flows, including endpoint, metadata, authorization, token, and dynamic-client-registration origins. Customer-managed installations can leave this empty.
ONECOMPUTER_HOSTED_MCP_EGRESS_ORIGINS=

# Runtime limits and security switches
# These are deployment controls, not Compose defaults. Keep the secure hosted Telegram setting explicit.
# Signed workspace-launch token lifetime in seconds.
ONECOMPUTER_WORKSPACE_INGRESS_LAUNCH_TTL_SECONDS=300
# Workspace ingress session lifetime in seconds.
ONECOMPUTER_WORKSPACE_INGRESS_SESSION_TTL_SECONDS=28800
# Whether workspace ingress verifies TLS for its configured internal upstreams.
ONECOMPUTER_WORKSPACE_INGRESS_VERIFY_UPSTREAM_TLS=false
# Agent bridge grant lifetime in seconds.
ONECOMPUTER_AGENT_BRIDGE_GRANT_TTL_SECONDS=900
# Gateway grant renewal interval in seconds.
ONECOMPUTER_GATEWAY_GRANT_RENEWAL_INTERVAL_SECONDS=900
# Channel broker polling interval in milliseconds.
ONECOMPUTER_CHANNEL_POLL_INTERVAL_MS=1000
# Telegram composition batching window in milliseconds.
ONECOMPUTER_TELEGRAM_COMPOSITION_WINDOW_MS=1500
# Set reject for hosted deployments. Empty keeps the safe runtime default for the selected profile.
ONECOMPUTER_TELEGRAM_RAW_TOKEN_INPUT_MODE=
# Telegram broker token-intake grant lifetime in seconds.
ONECOMPUTER_TELEGRAM_INTAKE_GRANT_TTL_SECONDS=300
# Attachment retention period in days.
ONECOMPUTER_CHAT_ATTACHMENT_RETENTION_DAYS=90
# Scheduler worker polling interval in milliseconds.
ONECOMPUTER_SCHEDULER_POLL_INTERVAL_MS=5000
# Maximum schedules claimed by one polling pass.
ONECOMPUTER_SCHEDULER_CLAIM_LIMIT=10
# Schedule claim lease duration in milliseconds.
ONECOMPUTER_SCHEDULER_CLAIM_LEASE_MS=120000
# Signed policy bundle lifetime in seconds.
ONECOMPUTER_POLICY_BUNDLE_TTL_SECONDS=86400

# Generated service, encryption, and internal-authentication secrets
# npm run env:init replaces every generated-by-env-init value with a distinct local secret. Production secrets belong in a secret manager.
# Web-to-Control proxy bearer token.
ONECOMPUTER_WEB_PROXY_TOKEN=generated-by-env-init
# Control-to-workspace-controller bearer token.
ONECOMPUTER_CONTROLLER_TOKEN=generated-by-env-init
# ONEComputer PostgreSQL password.
ONECOMPUTER_POSTGRES_PASSWORD=generated-by-env-init
# LiteLLM master key.
ONECOMPUTER_LITELLM_MASTER_KEY=generated-by-env-init
# LiteLLM credential-encryption salt.
ONECOMPUTER_LITELLM_SALT_KEY=generated-by-env-init
# LiteLLM credential encryption secret. It must remain distinct from session and ingress secrets.
ONECOMPUTER_LITELLM_CREDENTIAL_SECRET=generated-by-env-init
# LiteLLM PostgreSQL password.
ONECOMPUTER_LITELLM_POSTGRES_PASSWORD=generated-by-env-init
# Fixture-only approval secret for local qualification flows.
ONECOMPUTER_FIXTURE_APPROVAL_SECRET=generated-by-env-init
# Web session signing secret.
ONECOMPUTER_SESSION_SECRET=generated-by-env-init
# Workspace ingress signing secret.
ONECOMPUTER_WORKSPACE_INGRESS_SECRET=generated-by-env-init
# Egress grant derivation secret.
ONECOMPUTER_EGRESS_GRANT_SECRET=generated-by-env-init
# LiteLLM credential for the static model-provider egress proxy.
ONECOMPUTER_GATEWAY_EGRESS_PROXY_TOKEN=generated-by-env-init
# LiteLLM credential for the strict remote-MCP egress proxy.
ONECOMPUTER_REMOTE_MCP_EGRESS_PROXY_TOKEN=generated-by-env-init
# Remote MCP proxy credential for its narrow Control authorization callback.
ONECOMPUTER_MCP_EGRESS_PROXY_TOKEN=generated-by-env-init
# Dedicated agent bridge signing secret.
ONECOMPUTER_AGENT_BRIDGE_SECRET=generated-by-env-init
# Agent chat internal authentication secret.
ONECOMPUTER_HERMES_API_SECRET=generated-by-env-init
# Channel broker credential-vault encryption secret.
ONECOMPUTER_CHANNEL_CREDENTIAL_SECRET=generated-by-env-init
# Control-to-channel-broker bearer token.
ONECOMPUTER_CHANNEL_BROKER_TOKEN=generated-by-env-init
# Scheduler prompt signing secret.
ONECOMPUTER_SCHEDULE_PROMPT_SECRET=generated-by-env-init
# Scheduler-to-Control bearer token.
ONECOMPUTER_SCHEDULER_TOKEN=generated-by-env-init
# LiteLLM-to-Control usage bearer token.
ONECOMPUTER_AI_USAGE_TOKEN=generated-by-env-init
# AI usage task-binding secret.
ONECOMPUTER_AI_USAGE_TASK_BINDING_SECRET=generated-by-env-init

# OpenVTC, Web Push, policy, and Telegram key material
# Generated key pairs are coupled. Do not replace only one member of a group.
# Base64 OpenVTC executor seed.
ONECOMPUTER_OPENVTC_EXECUTOR_SEED_B64=generated-by-env-init
# OpenVTC consent service bearer token.
ONECOMPUTER_OPENVTC_CONSENT_TOKEN=generated-by-env-init
# Web Push VAPID subject.
ONECOMPUTER_WEB_PUSH_VAPID_SUBJECT=mailto:security@example.com
# Web Push VAPID public key.
ONECOMPUTER_WEB_PUSH_VAPID_PUBLIC_KEY=generated-by-env-init
# Web Push VAPID private key.
ONECOMPUTER_WEB_PUSH_VAPID_PRIVATE_KEY=generated-by-env-init
# Web Push subscription encryption secret.
ONECOMPUTER_WEB_PUSH_SUBSCRIPTION_SECRET=generated-by-env-init
# Active signed-policy key identifier.
ONECOMPUTER_POLICY_SIGNING_KEY_ID=generated-by-env-init
# Base64 DER signed-policy private key.
ONECOMPUTER_POLICY_SIGNING_PRIVATE_KEY_B64=generated-by-env-init
# Base64 signed-policy verification key set.
ONECOMPUTER_POLICY_VERIFICATION_KEYS_B64=generated-by-env-init
# Base64 DER broker-only Telegram intake grant private key.
ONECOMPUTER_TELEGRAM_INTAKE_GRANT_PRIVATE_KEY_B64=generated-by-env-init
# Base64 DER Telegram intake grant public key.
ONECOMPUTER_TELEGRAM_INTAKE_GRANT_PUBLIC_KEY_B64=generated-by-env-init
# Base64 DER broker-only Telegram token-envelope private key.
ONECOMPUTER_TELEGRAM_INTAKE_ENCRYPTION_PRIVATE_KEY_B64=generated-by-env-init
# Base64 DER Telegram token-envelope public key.
ONECOMPUTER_TELEGRAM_INTAKE_ENCRYPTION_PUBLIC_KEY_B64=generated-by-env-init

# Identity, Microsoft 365, and bootstrap
# Replace the Entra placeholders before enabling sign-in. Leave the dedicated Microsoft 365 app values empty to reuse the Web sign-in app.
# Microsoft Entra directory tenant ID.
ONECOMPUTER_ENTRA_TENANT_ID=replace-with-entra-directory-tenant-id
# Microsoft Entra Web application client ID.
ONECOMPUTER_ENTRA_CLIENT_ID=replace-with-entra-application-client-id
# Microsoft Entra Web application client secret.
ONECOMPUTER_ENTRA_CLIENT_SECRET=replace-with-entra-application-client-secret
# Comma-separated initial administrator email addresses.
ONECOMPUTER_ADMINISTRATOR_EMAILS=admin@example.com
# Dedicated Microsoft 365 MCP Entra tenant ID, or blank to reuse the Web sign-in app.
ONECOMPUTER_MS365_TENANT_ID=
# Dedicated Microsoft 365 MCP Entra client ID, or blank to reuse the Web sign-in app.
ONECOMPUTER_MS365_CLIENT_ID=
# Dedicated Microsoft 365 MCP Entra client secret, or blank to reuse the Web sign-in app.
ONECOMPUTER_MS365_CLIENT_SECRET=
# GitHub MCP OAuth app client ID.
ONECOMPUTER_GITHUB_MCP_CLIENT_ID=
# GitHub MCP OAuth app client secret.
ONECOMPUTER_GITHUB_MCP_CLIENT_SECRET=
# Initial owned tenant identifier.
ONECOMPUTER_BOOTSTRAP_TENANT_ID=example
# Initial owned administrator identifier.
ONECOMPUTER_BOOTSTRAP_USER_ID=bootstrap-admin
# Initial tenant display name.
ONECOMPUTER_TENANT_DISPLAY_NAME=Example Organization

# Microsoft 365 MCP safety limits
# These vendor settings are explicit deployment inputs so every target receives the same safety policy.
# Maximum items per Microsoft Graph request.
ONECOMPUTER_MS365_MAX_TOP=25
# Maximum Microsoft Graph pages per request.
ONECOMPUTER_MS365_MAX_PAGES=4
# Maximum aggregate Microsoft Graph items per request.
ONECOMPUTER_MS365_MAX_ITEMS=100
# Whether Microsoft 365 MCP redacts personally identifiable information.
ONECOMPUTER_MS365_REDACT_PII=true
# Whether Microsoft 365 MCP requires confirmation for mutations.
ONECOMPUTER_MS365_REQUIRE_CONFIRM=true
# Trusted proxy hops for Microsoft 365 MCP.
ONECOMPUTER_MS365_TRUST_PROXY_HOPS=0
# Microsoft 365 MCP log level.
ONECOMPUTER_MS365_LOG_LEVEL=info

# Workspace driver
# The canonical ONECOMPUTER_* names replace legacy SANDBOX_DRIVER and KASM_* inputs. env:update migrates existing values without rotation.
# Workspace driver: kasm-local or kasm.
ONECOMPUTER_SANDBOX_DRIVER=kasm-local
# Workspace container image.
ONECOMPUTER_WORKSPACE_IMAGE=onecomputer/workspace:dev
# Trusted IANA timezone for workspace and relative calendar times.
ONECOMPUTER_TIME_ZONE=Etc/UTC
# Local Kasm workspace network-name prefix.
ONECOMPUTER_KASM_LOCAL_NETWORK_PREFIX=onecomputer-workspace
# Local Kasm egress network name.
ONECOMPUTER_KASM_LOCAL_EGRESS_NETWORK=onecomputer-egress
# Expose KVM devices only to supported local desktop workspaces.
ONECOMPUTER_KASM_LOCAL_KVM_ENABLED=false
# Local workspace startup timeout in milliseconds.
ONECOMPUTER_KASM_LOCAL_STARTUP_TIMEOUT_MS=60000
# Host address advertised by the local Kasm adapter.
ONECOMPUTER_KASM_PUBLIC_HOST=127.0.0.1
# Kasm Developer API base URL when ONECOMPUTER_SANDBOX_DRIVER=kasm.
ONECOMPUTER_KASM_BASE_URL=
# Kasm Developer API key.
ONECOMPUTER_KASM_API_KEY=
# Kasm Developer API secret.
ONECOMPUTER_KASM_API_SECRET=
# Kasm user ID.
ONECOMPUTER_KASM_USER_ID=
# Kasm image ID.
ONECOMPUTER_KASM_IMAGE_ID=
