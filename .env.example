# ONEComputer reference Compose environment
#
# Run `npm run env:init` to create .env with fresh local secrets, then replace
# the provider and Microsoft Entra placeholders below. Never commit .env.

# Public endpoints. The reference stack binds to loopback by default.
ONECOMPUTER_HTTP_BIND_ADDRESS=127.0.0.1
ONECOMPUTER_WEB_PORT=4174
ONECOMPUTER_LITELLM_PORT=4000
ONECOMPUTER_M365_PORT=4311
ONECOMPUTER_PUBLIC_WEB_URL=http://localhost:4174
ONECOMPUTER_LITELLM_PUBLIC_URL=http://localhost:4000
ONECOMPUTER_M365_AUTHORIZATION_ORIGIN=http://localhost:4311

# Optional runtime tuning. These values match the reference Compose defaults.
ONECOMPUTER_WORKSPACE_INGRESS_LAUNCH_TTL_SECONDS=300
ONECOMPUTER_WORKSPACE_INGRESS_SESSION_TTL_SECONDS=28800
ONECOMPUTER_CHANNEL_POLL_INTERVAL_MS=1000
ONECOMPUTER_SCHEDULER_POLL_INTERVAL_MS=5000
ONECOMPUTER_SCHEDULER_CLAIM_LIMIT=10
ONECOMPUTER_SCHEDULER_CLAIM_LEASE_MS=120000

# Internal authentication, database, encryption, and gateway secrets.
# `npm run env:init` replaces every value in this section.
ONECOMPUTER_WEB_PROXY_TOKEN=generated-by-env-init
ONECOMPUTER_CONTROLLER_TOKEN=generated-by-env-init
ONECOMPUTER_POSTGRES_PASSWORD=generated-by-env-init
ONECOMPUTER_LITELLM_MASTER_KEY=generated-by-env-init
ONECOMPUTER_LITELLM_SALT_KEY=generated-by-env-init
ONECOMPUTER_LITELLM_CREDENTIAL_SECRET=generated-by-env-init
ONECOMPUTER_LITELLM_POSTGRES_PASSWORD=generated-by-env-init
ONECOMPUTER_LITELLM_UI_USERNAME=admin
ONECOMPUTER_LITELLM_UI_PASSWORD=generated-by-env-init
ONECOMPUTER_FIXTURE_APPROVAL_SECRET=generated-by-env-init
ONECOMPUTER_SESSION_SECRET=generated-by-env-init
ONECOMPUTER_WORKSPACE_INGRESS_SECRET=generated-by-env-init
ONECOMPUTER_EGRESS_GRANT_SECRET=generated-by-env-init
ONECOMPUTER_HERMES_API_SECRET=generated-by-env-init
ONECOMPUTER_CHANNEL_CREDENTIAL_SECRET=generated-by-env-init
ONECOMPUTER_CHANNEL_BROKER_TOKEN=generated-by-env-init
ONECOMPUTER_SCHEDULE_PROMPT_SECRET=generated-by-env-init
ONECOMPUTER_SCHEDULER_TOKEN=generated-by-env-init

# OpenVTC executor identity and optional Web Push delivery.
ONECOMPUTER_OPENVTC_EXECUTOR_SEED_B64=generated-by-env-init
ONECOMPUTER_OPENVTC_CONSENT_TOKEN=generated-by-env-init
ONECOMPUTER_WEB_PUSH_VAPID_SUBJECT=mailto:security@example.com
ONECOMPUTER_WEB_PUSH_VAPID_PUBLIC_KEY=generated-by-env-init
ONECOMPUTER_WEB_PUSH_VAPID_PRIVATE_KEY=generated-by-env-init
ONECOMPUTER_WEB_PUSH_SUBSCRIPTION_SECRET=generated-by-env-init

# Signed effective-policy authority.
ONECOMPUTER_POLICY_SIGNING_KEY_ID=generated-by-env-init
ONECOMPUTER_POLICY_SIGNING_PRIVATE_KEY_B64=generated-by-env-init
ONECOMPUTER_POLICY_VERIFICATION_KEYS_B64=generated-by-env-init
ONECOMPUTER_POLICY_BUNDLE_TTL_SECONDS=86400

# Model providers. The default onecomputer-assistant route requires OpenAI.
# Other keys are optional until their corresponding route is assigned.
ONECOMPUTER_OPENAI_API_KEY=replace-with-provider-key
ONECOMPUTER_CLAUDE_API_KEY=
ONECOMPUTER_GLM_API_KEY=

# ONEComputer Web sign-in. Register this Web redirect URI in Microsoft Entra:
# http://localhost:4174/api/v1/auth/callback
ONECOMPUTER_ENTRA_TENANT_ID=replace-with-entra-directory-tenant-id
ONECOMPUTER_ENTRA_CLIENT_ID=replace-with-entra-application-client-id
ONECOMPUTER_ENTRA_CLIENT_SECRET=replace-with-entra-application-client-secret
ONECOMPUTER_ADMINISTRATOR_EMAILS=admin@example.com

# Microsoft 365 MCP OAuth. Empty values reuse the Web sign-in application.
# For stronger isolation, configure a dedicated Entra application and register
# http://localhost:4000/callback as its Web redirect URI.
ONECOMPUTER_MS365_TENANT_ID=
ONECOMPUTER_MS365_CLIENT_ID=
ONECOMPUTER_MS365_CLIENT_SECRET=

# GitHub does not offer dynamic client registration. Register an OAuth app with
# http://localhost:4000/callback; these values are passed to LiteLLM only.
ONECOMPUTER_GITHUB_MCP_CLIENT_ID=
ONECOMPUTER_GITHUB_MCP_CLIENT_SECRET=

# Initial owned tenant and administrator records created after first sign-in.
ONECOMPUTER_BOOTSTRAP_TENANT_ID=example
ONECOMPUTER_BOOTSTRAP_USER_ID=bootstrap-admin
ONECOMPUTER_TENANT_DISPLAY_NAME=Example Organization

# Local Docker/Kasm workspace driver.
SANDBOX_DRIVER=kasm-local
ONECOMPUTER_IMAGE_TAG=dev
ONECOMPUTER_WORKSPACE_IMAGE=onecomputer/workspace:dev
# Trusted IANA timezone for the employee workspace and relative calendar times.
# `npm run env:init` replaces this with the timezone reported by the host.
ONECOMPUTER_TIME_ZONE=Etc/UTC
KASM_LOCAL_NETWORK_PREFIX=onecomputer-workspace
KASM_LOCAL_EGRESS_NETWORK=onecomputer-egress
KASM_PUBLIC_HOST=127.0.0.1

# Production Kasm Developer API adapter (set SANDBOX_DRIVER=kasm).
KASM_BASE_URL=
KASM_API_KEY=
KASM_API_SECRET=
KASM_USER_ID=
KASM_IMAGE_ID=
