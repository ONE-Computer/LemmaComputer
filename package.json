{
  "name": "lemmacomputer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "tsx --test tests/**/*.test.ts",
    "test:ui": "playwright test --config tests/ui/playwright.config.ts",
    "test:ui:auth": "playwright test --config tests/ui/customer-auth.config.ts",
    "test:ui:activity": "playwright test --config tests/ui/playwright.config.ts activity-panel.spec.ts",
    "test:ui:activity:update": "playwright test --config tests/ui/playwright.config.ts activity-panel.spec.ts --update-snapshots",
    "test:ui:operator": "playwright test --config tests/ui/platform-operator.config.ts",
    "test:ui:responsive": "playwright test --config tests/ui/playwright.config.ts responsive-remediation.spec.ts customer-authentication.spec.ts chat-composer-docking.spec.ts activity-panel.spec.ts",
    "test:integration:mcp-egress": "node tests/integration/gateway/mcp-egress.mjs",
    "test:integration:microsoft365-contracts": "tsx tests/integration/microsoft365/contracts.mts",
    "test:integration:oauth": "tsx tests/integration/gateway/oauth-renewal.mts",
    "test:integration:providers": "tsx tests/integration/gateway/provider-settings.mts",
    "test:integration:hermes-runtime": "python3 tests/integration/agents/hermes-runtime.py",
    "test:integration:codex-runtime": "python3 tests/integration/agents/codex-runtime.py",
    "release:check-reasoning": "tsx scripts/release/validate-reasoning-evidence.mts",
    "test:integration:workspace-startup": "tsx tests/integration/workspace/startup.mts",
    "test:mtls": "tsx --test tests/internal-mtls-boundaries.test.ts tests/litellm-admin-proxy.test.ts",
    "dev:remote-workspace": "node scripts/development/remote-workspace-node.mjs",
    "test:integration:artifact-store": "tsx tests/integration/storage/artifact-store.mts",
    "benchmark:workspace": "node tests/performance/benchmark-workspace.mjs",
    "benchmark:kasm-browser": "node tests/performance/collect-kasm-browser-runtime.mjs",
    "fixtures:office-regression": "python3 tests/fixtures/office-regression/generate.py --output tests/fixtures/office-regression",
    "test:integration:office": "node tests/integration/office/roundtrip.mjs",
    "test:profiles": "tsx --test tests/deployment-profile.test.ts tests/deployment-config.test.ts",
    "apparmor:electron:check": "node scripts/development/install-electron-apparmor.mjs check",
    "test:integration:auth": "npm run qualify:better-auth -w @lemmacomputer/control-api",
    "test:integration:governed-routing": "docker run --rm --entrypoint python --mount type=bind,src=./tests/integration/gateway/governed-routing.py,dst=/qualification.py,readonly --mount type=bind,src=./integrations/litellm/lemmacomputer_policy_callback.py,dst=/callback.py,readonly ghcr.io/berriai/litellm:v1.93.0@sha256:a1745e629abfb17d434426ff48b115f54f4f4c4a0f5af241de569e93c63c411e /qualification.py",
    "test:integration:mcp-audit-hooks": "docker run --rm --entrypoint python --mount type=bind,src=./tests/integration/gateway/mcp-audit-hooks.py,dst=/qualification.py,readonly ghcr.io/berriai/litellm:v1.93.0@sha256:a1745e629abfb17d434426ff48b115f54f4f4c4a0f5af241de569e93c63c411e /qualification.py",
    "benchmark:tool-audit": "node tests/performance/tool-audit-volume.mjs",
    "env:init": "node scripts/setup/initialize-env.mjs",
    "env:example": "node scripts/setup/render-env-example.mjs --check",
    "env:qualification:example": "node scripts/setup/render-env-example.mjs --qualification --check",
    "env:check": "node scripts/setup/update-env.mjs --check",
    "env:update": "node scripts/setup/update-env.mjs --write",
    "env:render": "node scripts/setup/render-service-env.mjs",
    "compose:config": "node scripts/setup/render-service-env.mjs && docker compose config --quiet",
    "compose:up": "node scripts/setup/render-service-env.mjs && docker compose up -d --build --wait --wait-timeout 300",
    "compose:down": "node scripts/development/compose-down.mjs",
    "image:workspace": "node scripts/setup/render-service-env.mjs && docker compose --profile build build workspace-image",
    "dev:control": "npm run dev -w @lemmacomputer/control-api",
    "dev:controller": "npm run dev -w @lemmacomputer/workspace-controller",
    "dev:web": "npm run dev -w web",
    "db:migrate": "tsx apps/control-api/src/migrate.ts",
    "auth:db:migrate": "tsx apps/control-api/src/migrate-auth.ts",
    "auth:db:check": "tsx apps/control-api/src/check-auth-schema.ts",
    "dev:ui-fixture": "node tests/ui/fixtures/server.mjs",
    "worktree:init": "node scripts/development/worktree-init.mjs",
    "dev:doctor": "node scripts/development/dev-doctor.mjs",
    "verify:quick": "node scripts/development/verify-quick.mjs",
    "verify:db": "node tests/integration/database/verify.mjs",
    "verify:release": "node scripts/release/verify-release.mjs",
    "demo:update": "node scripts/release/demo-update.mjs",
    "release:tag": "node scripts/release/release-tag.mjs",
    "db:migration:new": "node scripts/database/migration-new.mjs",
    "db:backfill:organization-rbac": "node --import tsx scripts/database/backfill-organization-rbac.ts",
    "db:check": "tsx apps/control-api/src/check-schema.ts",
    "test:integration:consent": "node tests/integration/consent/interop.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "24.10.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "react-qr-code": "^2.2.0"
  }
}
